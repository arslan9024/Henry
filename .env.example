# Henry team-scale runtime configuration
# Keep real credentials in deployment secrets; never commit them.

# local | firebase
VITE_HENRY_STORAGE_PROVIDER=local

# Required only when VITE_HENRY_STORAGE_PROVIDER=firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# Storage authorization comes from the short-lived Firebase Auth session token.
# Never add bearer tokens to VITE_* variables: Vite embeds them in the client bundle.
